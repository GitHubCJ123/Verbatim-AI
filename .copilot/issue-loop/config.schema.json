{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verbatim AI local issue automation config",
  "type": "object",
  "required": ["enabled", "dryRun", "repository", "baseBranch", "requiredLabels", "agents", "gates"],
  "properties": {
    "enabled": { "type": "boolean" },
    "dryRun": { "type": "boolean" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "baseBranch": { "type": "string", "minLength": 1 },
    "pollIntervalSeconds": { "type": "integer", "minimum": 60 },
    "maxConcurrentIssues": { "type": "integer", "minimum": 1, "maximum": 5 },
    "maxIssuesPerTick": { "type": "integer", "minimum": 1, "maximum": 25 },
    "maxPrReviewIterations": { "type": "integer", "minimum": 1, "maximum": 5 },
    "requiredLabels": { "type": "array", "items": { "type": "string" } },
    "excludedLabels": { "type": "array", "items": { "type": "string" } },
    "branchPrefix": { "type": "string" },
    "worktrees": {
      "type": "object",
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "cleanupMergedPrBranches": { "type": "boolean" }
      }
    },
    "reviewers": { "type": "array", "items": { "type": "string" } },
    "teamReviewers": { "type": "array", "items": { "type": "string" } },
    "trustedApprovers": { "type": "array", "items": { "type": "string" } },
    "claimTtlMinutes": { "type": "integer", "minimum": 15 },
    "gates": {
      "type": "object",
      "required": ["requireHumanMerge", "requireScreenshotsForUxChanges"],
      "properties": {
        "requireHumanOnSpecReviewQuestions": { "type": "boolean" },
        "requireHumanMerge": { "type": "boolean" },
        "requireScreenshotsForUxChanges": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultPolicy": { "type": "string" },
        "budgets": {
          "type": "object",
          "properties": {
            "maxModelCallsPerIssue": { "type": "integer", "minimum": 1 },
            "maxModelCallsPerPhase": { "type": "integer", "minimum": 1 },
            "maxCouncilRounds": { "type": "integer", "minimum": 1 },
            "maxImplementationAttempts": { "type": "integer", "minimum": 1 },
            "maxVerifierRepairAttempts": { "type": "integer", "minimum": 1 },
            "maxWallClockMinutesPerIssue": { "type": "integer", "minimum": 1 }
          }
        },
        "locking": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "ttlMinutes": { "type": "integer", "minimum": 1 }
          }
        },
        "phases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "allowedTiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "requirementsCritic",
                    "diverseRetry",
                    "council",
                    "sequentialRetry",
                    "repairOnly"
                  ]
                }
              },
              "securityVeto": { "type": "boolean" },
              "verifierAuthoritative": { "type": "boolean" },
              "maxAttempts": { "type": "integer", "minimum": 1 },
              "branchStrategy": {
                "type": "string",
                "enum": ["incremental-after-pr", "replace-before-pr"]
              },
              "allowAiDowngrade": { "type": "boolean" },
              "allowAiDowngradeForSecuritySensitive": { "type": "boolean", "const": false }
            }
          }
        },
        "rosters": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}

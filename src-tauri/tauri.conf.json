{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verbatim AI",
  "version": "0.3.4",
  "identifier": "com.verbatimai.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Verbatim AI",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "visible": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Verbatim AI Overlay",
        "width": 420,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "publisher": "Verbatim AI",
    "category": "Productivity",
    "shortDescription": "Voice transcription.",
    "longDescription": "Hold a hotkey, speak, and get polished text pasted into any app.",
    "copyright": "Copyright © 2026 Verbatim AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/GitHubCJ123/Verbatim-AI/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QTE5OEJDMDBBRTE5MDIKUldRQ0dhNEF2SmloaWJyUHQwdGY3TmFZbzkxZndpVkQ2RjhxTXZUb05sSkVkc3U5RzZocUxZNlAK"
    }
  }
}

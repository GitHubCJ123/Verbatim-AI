# Verbatim AI environment variables (copy to .env.local; never commit secrets)

# Supabase (public — safe to expose to the Vite client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional soft Edge Function attestation header. Leave blank unless the
# Supabase functions have VERBATIM_EDGE_APP_SECRET configured.
VITE_VERBATIM_EDGE_APP_SECRET=

# Azure AI Foundry (NOTE: API keys must NOT live here in production —
# they belong in the OS credential store via the Settings UI.
# These are only for local dev convenience.)
VITE_AZURE_ENDPOINT=
VITE_AZURE_TRANSCRIBE_DEPLOYMENT=
VITE_AZURE_CHAT_DEPLOYMENT=

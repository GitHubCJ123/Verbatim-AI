{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verbatim AI local issue automation config",
  "type": "object",
  "required": ["enabled", "dryRun", "repository", "baseBranch", "requiredLabels", "agents", "gates"],
  "properties": {
    "enabled": { "type": "boolean" },
    "dryRun": { "type": "boolean" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "baseBranch": { "type": "string", "minLength": 1 },
    "pollIntervalSeconds": { "type": "integer", "minimum": 60 },
    "maxConcurrentIssues": { "type": "integer", "minimum": 1, "maximum": 5 },
    "maxIssuesPerTick": { "type": "integer", "minimum": 1, "maximum": 5 },
    "maxPrReviewIterations": { "type": "integer", "minimum": 1, "maximum": 5 },
    "requiredLabels": { "type": "array", "items": { "type": "string" } },
    "excludedLabels": { "type": "array", "items": { "type": "string" } },
    "branchPrefix": { "type": "string" },
    "worktrees": {
      "type": "object",
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "cleanupMergedPrBranches": { "type": "boolean" }
      }
    },
    "reviewers": { "type": "array", "items": { "type": "string" } },
    "teamReviewers": { "type": "array", "items": { "type": "string" } },
    "trustedApprovers": { "type": "array", "items": { "type": "string" } },
    "claimTtlMinutes": { "type": "integer", "minimum": 15 },
    "gates": {
      "type": "object",
      "required": ["requireHumanMerge", "requireScreenshotsForUxChanges"],
      "properties": {
        "requireHumanOnSpecReviewQuestions": { "type": "boolean" },
        "requireHumanMerge": { "type": "boolean" },
        "requireScreenshotsForUxChanges": { "type": "boolean" }
      }
    }
  }
}
